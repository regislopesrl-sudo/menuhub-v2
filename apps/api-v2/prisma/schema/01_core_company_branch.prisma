// core company branch



model Company {
  id        String   @id @default(uuid()) @map("id")
  name      String?  @map("name")
  document  String?  @map("document")
  slug      String?  @unique @map("slug")
  status    CompanyStatus @default(ACTIVE) @map("status")
  legalName String   @map("legal_name")
  tradeName String   @map("trade_name")
  cnpj      String?  @unique @map("cnpj")
  phone     String?  @map("phone")
  whatsapp  String?  @map("whatsapp")
  email     String?  @map("email")
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches          Branch[]
  customers         Customer[]
  productCategories ProductCategory[]
  stockCategories   StockCategory[]
  products          Product[]
  addonGroups       AddonGroup[]
  combos            Combo[]
  stockItems        StockItem[]
  recipes           Recipe[]
  menuProducts      MenuProduct[]
  coupons           Coupon[]
  giftCards         GiftCard[]
  loyaltyAccounts   LoyaltyAccount[]
  loyaltyTransactions LoyaltyTransaction[]
  orders            Order[]
  configuration     CompanyConfiguration?
  customRoles       CompanyRole[]
  fiscalConfigurations FiscalConfiguration[] @relation("CompanyFiscalConfigurations")
  fiscalDocuments   FiscalDocument[] @relation("CompanyFiscalDocuments")
  settings          CompanySetting[]
  reviews           Review[]
  subscriptions     CompanySubscription[]
  moduleOverrides   CompanyModuleOverride[]
  moduleAuditLogs   CompanyModuleAuditLog[]
  memberships       UserCompanyMembership[]
  billingAccount    BillingAccount?
  invoices          Invoice[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @map("id")
  companyId String   @map("company_id")
  name      String   @map("name")
  code      String?  @map("code")
  phone     String?  @map("phone")
  whatsapp  String?  @map("whatsapp")
  email     String?  @map("email")
  city      String?  @map("city")
  state     String?  @map("state")
  zipCode   String?  @map("zip_code")
  street    String?  @map("street")
  number    String?  @map("number")
  complement String? @map("complement")
  district  String?  @map("district")
  latitude  Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude Decimal? @map("longitude") @db.Decimal(10, 7)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orders                 Order[]
  fiscalConfigurations   FiscalConfiguration[] @relation("BranchFiscalConfigurations")
  fiscalDocuments        FiscalDocument[] @relation("BranchFiscalDocuments")
  settings               CompanySetting[]
  tables                 TableRestaurant[]
  tableSessions          TableSession[]
  commands               Command[]
  reservations           Reservation[]
  waitlists              Waitlist[]
  couriers               Courier[]
  deliveryAreas          DeliveryArea[]
  productionOrders       ProductionOrder[]
  counterOrders          CounterOrder[]
  userAccesses           UserBranchAccess[]
  realtimeOutboxEvents   RealtimeOutboxEvent[]
  realtimeSocketSessions RealtimeSocketSession[]
  stockBatches           StockBatch[]
  stockMovements         StockMovement[]
  stockLocationBalances  StockLocationBalance[]
  cashRegisters          CashRegister[]
  cashMovements          CashMovement[]
  accountsPayables       AccountsPayable[]
  accountsReceivables    AccountsReceivable[]
  receivableSettlements  ReceivableSettlement[]
  payableSettlements     PayableSettlement[]
  dailyFinancialClosures DailyFinancialClosure[]
  financialLedgerEntries FinancialLedgerEntry[]
  financialReconciliationBatches FinancialReconciliationBatch[]
  financialReconciliationItems FinancialReconciliationItem[]

  @@index([companyId])
  @@map("branches")
}

model CompanySetting {
  id        String @id @default(uuid()) @map("id")
  companyId String @map("company_id")
  branchId  String @map("branch_id")
  key       String @map("key")
  value     Json   @map("value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, key])
  @@map("company_settings")
}

model CompanyConfiguration {
  id                String   @id @default(uuid()) @map("id")
  companyId         String   @unique @map("company_id")
  brandColor        String?  @map("brand_color")
  timezone          String?  @map("timezone")
  currency          String   @default("BRL") @map("currency")
  isActive          Boolean  @default(true) @map("is_active")
  publicTitle       String?  @map("public_title")
  publicDescription String?  @map("public_description")
  bannerUrl         String?  @map("banner_url")
  closedMessage     String?  @map("closed_message")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_configurations")
}

model Customer {
  id        String    @id @default(uuid()) @map("id")
  companyId String    @map("company_id")
  name      String    @map("name")
  phone     String?   @map("phone")
  whatsapp  String?   @map("whatsapp")
  email     String?   @map("email")
  cpfCnpj   String?   @map("cpf_cnpj")
  birthDate DateTime? @map("birth_date")
  notes     String?   @map("notes")
  isVip     Boolean   @default(false) @map("is_vip")
  isBlocked Boolean   @default(false) @map("is_blocked")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  addresses              CustomerAddress[]
  orders                 Order[]
  receivables            AccountsReceivable[]
  commands               Command[]
  reservations           Reservation[]
  waitlists              Waitlist[]
  whatsappConversations  WhatsappConversation[]
  loyaltyAccount         LoyaltyAccount?
  loyaltyTransactions    LoyaltyTransaction[]
  reviews                Review[]
  realtimeSocketSessions RealtimeSocketSession[]
  realtimeOutboxEvents   RealtimeOutboxEvent[]

  @@index([companyId])
  @@index([phone, whatsapp])
  @@map("customers")
}

model CustomerAddress {
  id             String  @id @default(uuid()) @map("id")
  customerId     String  @map("customer_id")
  deliveryAreaId String? @map("delivery_area_id")
  label          String? @map("label")
  zipCode        String? @map("zip_code")
  street         String  @map("street")
  number         String  @map("number")
  complement     String? @map("complement")
  district       String  @map("district")
  city           String  @map("city")
  state          String  @map("state")
  reference      String? @map("reference")
  ibgeCode       String? @map("ibge_code")
  latitude       Float?  @map("latitude")
  longitude      Float?  @map("longitude")
  isDefault      Boolean @default(false) @map("is_default")

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveryArea DeliveryArea? @relation("deliveryAreaAddresses", fields: [deliveryAreaId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([customerId])
  @@map("customer_addresses")
}

