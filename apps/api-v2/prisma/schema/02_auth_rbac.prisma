// auth rbac



model User {
  id           String    @id @default(uuid()) @map("id")
  name         String    @map("name")
  email        String?   @unique @map("email")
  phone        String?   @map("phone")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  roles                         UserRole[]
  waiterPinCredential           WaiterPinCredential?
  refreshTokens                 RefreshToken[]
  assignedWhatsappConversations WhatsappConversation[]
  handledReviews                Review[]
  ordersCreated                 Order[]                 @relation("OrderCreatedBy")
  orderStatusLogs               OrderStatusLog[]
  orderTimelineEvents           OrderTimelineEvent[]
  branchAccesses                UserBranchAccess[]
  memberships                   UserCompanyMembership[]
  companyUserRoles              CompanyUserRole[]
  realtimeSocketSessions        RealtimeSocketSession[]
  realtimeOutboxEvents          RealtimeOutboxEvent[]
  authSecurityEvents            AuthSecurityEvent[]
  openedCashRegisters           CashRegister[]             @relation("CashRegisterOpenedBy")
  closedCashRegisters           CashRegister[]             @relation("CashRegisterClosedBy")
  createdCashMovements          CashMovement[]             @relation("CashMovementCreatedBy")
  receivableSettlements         ReceivableSettlement[]     @relation("ReceivableSettlementCreatedBy")
  payableSettlements            PayableSettlement[]        @relation("PayableSettlementCreatedBy")
  createdFinancialClosures      DailyFinancialClosure[]    @relation("DailyFinancialClosureCreatedBy")
  closedFinancialClosures       DailyFinancialClosure[]    @relation("DailyFinancialClosureClosedBy")
  financialLedgerEntries        FinancialLedgerEntry[]     @relation("FinancialLedgerEntryActor")
  financialReconciliationBatches FinancialReconciliationBatch[] @relation("FinancialReconciliationBatchCreatedBy")
  financialReconciliationItems  FinancialReconciliationItem[] @relation("FinancialReconciliationItemResolvedBy")
  openedTableSessions           TableSession[] @relation("TableSessionOpenedBy")
  closedTableSessions           TableSession[] @relation("TableSessionClosedBy")

  @@map("users")
}

model UserCompanyMembership {
  id         String   @id @default(uuid()) @map("id")
  userId     String   @map("user_id")
  companyId  String   @map("company_id")
  roleKey    String   @map("role_key")
  isActive   Boolean  @default(true) @map("is_active")
  invitedAt  DateTime @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, isActive])
  @@map("user_company_memberships")
}

model WaiterPinCredential {
  id            String    @id @default(uuid()) @map("id")
  userId        String    @unique @map("user_id")
  pinLookupHash String    @unique @map("pin_lookup_hash")
  pinHash       String    @map("pin_hash")
  label         String?   @map("label")
  isActive      Boolean   @default(true) @map("is_active")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("waiter_pin_credentials")
}

model Role {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @map("id")
  code        String   @unique @map("code")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid()) @map("id")
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid()) @map("id")
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @map("id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  deviceFingerprint String? @map("device_fingerprint")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt, createdAt])
  @@map("refresh_tokens")
}

model AuthSecurityEvent {
  id                String                   @id @default(uuid()) @map("id")
  userId            String?                  @map("user_id")
  action            AuthSecurityEventAction  @map("action")
  outcome           AuthSecurityEventOutcome @map("outcome")
  email             String?                  @map("email")
  ipAddress         String?                  @map("ip_address")
  userAgent         String?                  @map("user_agent")
  deviceFingerprint String?                  @map("device_fingerprint")
  metadata          Json?                    @map("metadata")
  createdAt         DateTime                 @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("auth_security_events")
}

model CompanyRole {
  id          String   @id @default(uuid()) @map("id")
  companyId   String   @map("company_id")
  key         String   @map("key")
  name        String   @map("name")
  description String?  @map("description")
  isSystem    Boolean  @default(false) @map("is_system")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions     CompanyRolePermission[]
  userAssignments CompanyUserRole[]

  @@unique([companyId, key])
  @@unique([companyId, id])
  @@index([companyId])
  @@map("company_roles")
}

model CompanyPermission {
  id          String   @id @default(uuid()) @map("id")
  key         String   @unique @map("key")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles CompanyRolePermission[]

  @@map("company_permissions")
}

model CompanyRolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       CompanyRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission CompanyPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("company_role_permissions")
}

model CompanyUserRole {
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role CompanyRole @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([companyId])
  @@map("company_user_roles")
}

model UserBranchAccess {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branch_accesses")
}

