model PurchaseReceipt {
  id                  String    @id @default(cuid()) @map("id")
  companyId           String    @map("company_id")
  branchId            String    @map("branch_id")
  supplierId          String?   @map("supplier_id")
  purchaseOrderId     String?   @map("purchase_order_id")
  status              String    @default("DRAFT") @map("status")
  receivedByUserId    String?   @map("received_by_user_id")
  receivedAt          DateTime? @map("received_at")
  documentNumber      String?   @map("document_number")
  fiscalKey           String?   @map("fiscal_key")
  totalReceivedAmount Decimal   @default(0) @map("total_received_amount") @db.Decimal(14, 2)
  notes               String?   @map("notes")
  metadata            Json?     @map("metadata")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  items         PurchaseReceiptItem[]

  @@unique([companyId, fiscalKey])
  @@index([companyId])
  @@index([companyId, branchId])
  @@index([companyId, supplierId])
  @@index([companyId, purchaseOrderId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String    @id @default(cuid()) @map("id")
  companyId           String    @map("company_id")
  branchId            String    @map("branch_id")
  receiptId           String    @map("receipt_id")
  purchaseOrderItemId String?   @map("purchase_order_item_id")
  stockItemId         String?   @map("stock_item_id")
  description         String?   @map("description")
  quantityReceived    Decimal   @map("quantity_received") @db.Decimal(14, 4)
  unitOfMeasure       String    @map("unit_of_measure")
  unitCost            Decimal?  @map("unit_cost") @db.Decimal(14, 4)
  totalCost           Decimal?  @map("total_cost") @db.Decimal(14, 2)
  divergenceType      String?   @map("divergence_type")
  mappingStatus       String?   @map("mapping_status")
  notes               String?   @map("notes")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id])

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([receiptId])
  @@index([stockItemId])
  @@index([purchaseOrderItemId])
  @@map("purchase_receipt_items")
}

model PurchaseQuote {
  id             String    @id @default(cuid()) @map("id")
  companyId      String    @map("company_id")
  supplierId     String    @map("supplier_id")
  stockItemId    String?   @map("stock_item_id")
  status         String    @default("DRAFT") @map("status")
  quotedUnitCost Decimal?  @map("quoted_unit_cost") @db.Decimal(14, 4)
  unitOfMeasure  String?   @map("unit_of_measure")
  validUntil     DateTime? @map("valid_until")
  notes          String?   @map("notes")
  metadata       Json?     @map("metadata")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([companyId])
  @@index([companyId, supplierId])
  @@index([companyId, stockItemId])
  @@index([companyId, status])
  @@index([validUntil])
  @@map("purchase_quotes")
}

model PurchaseConference {
  id                String    @id @default(cuid()) @map("id")
  companyId         String    @map("company_id")
  branchId          String    @map("branch_id")
  supplierId        String?   @map("supplier_id")
  purchaseOrderId   String?   @map("purchase_order_id")
  receiptId         String?   @map("receipt_id")
  sourceType        String    @default("MANUAL") @map("source_type")
  status            String    @default("DRAFT") @map("status")
  fiscalKey         String?   @map("fiscal_key")
  documentNumber    String?   @map("document_number")
  totalAmount       Decimal?  @map("total_amount") @db.Decimal(14, 2)
  notes             String?   @map("notes")
  metadata          Json?     @map("metadata")
  createdByUserId   String?   @map("created_by_user_id")
  confirmedByUserId String?   @map("confirmed_by_user_id")
  confirmedAt       DateTime? @map("confirmed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  items PurchaseConferenceItem[]

  @@unique([companyId, fiscalKey])
  @@index([companyId])
  @@index([companyId, branchId])
  @@index([companyId, status])
  @@index([companyId, sourceType])
  @@index([companyId, createdAt])
  @@map("purchase_conferences")
}

model PurchaseConferenceItem {
  id             String   @id @default(cuid()) @map("id")
  companyId      String   @map("company_id")
  branchId       String   @map("branch_id")
  conferenceId   String   @map("conference_id")
  stockItemId    String?  @map("stock_item_id")
  description    String?  @map("description")
  quantity       Decimal  @map("quantity") @db.Decimal(14, 4)
  unitOfMeasure  String?  @map("unit_of_measure")
  unitCost       Decimal? @map("unit_cost") @db.Decimal(14, 4)
  totalCost      Decimal? @map("total_cost") @db.Decimal(14, 2)
  divergenceType String?  @map("divergence_type")
  mappingStatus  String?  @map("mapping_status")
  notes          String?  @map("notes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conference PurchaseConference @relation(fields: [conferenceId], references: [id])

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([conferenceId])
  @@index([stockItemId])
  @@map("purchase_conference_items")
}
