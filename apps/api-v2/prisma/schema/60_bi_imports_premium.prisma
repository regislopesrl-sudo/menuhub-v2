model BranchSalesImport {
  id               String    @id @default(cuid()) @map("id")
  companyId        String    @map("company_id")
  branchId         String    @map("branch_id")
  status           String    @default("PENDING") @map("status")
  sourceType       String    @default("MANUAL_UPLOAD") @map("source_type")
  originalFileName String?   @map("original_file_name")
  fileHash         String?   @map("file_hash")
  periodStart      DateTime? @map("period_start")
  periodEnd        DateTime? @map("period_end")
  totalRows        Int       @default(0) @map("total_rows")
  processedRows    Int       @default(0) @map("processed_rows")
  failedRows       Int       @default(0) @map("failed_rows")
  dataStatus       String    @default("NO_DATA") @map("data_status")
  errorSummary     Json?     @map("error_summary")
  metadata         Json?     @map("metadata")
  createdByUserId  String?   @map("created_by_user_id")
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  rows         BranchSalesImportRow[]
  salesHistory ImportedSalesHistory[]

  @@unique([companyId, branchId, fileHash])
  @@index([companyId])
  @@index([companyId, branchId])
  @@index([companyId, status])
  @@index([companyId, periodStart, periodEnd])
  @@index([companyId, createdAt])
  @@map("branch_sales_imports")
}

model BranchSalesImportRow {
  id              String   @id @default(cuid()) @map("id")
  companyId       String   @map("company_id")
  branchId        String   @map("branch_id")
  importId        String   @map("import_id")
  rowNumber       Int      @map("row_number")
  status          String   @default("PENDING") @map("status")
  externalOrderId String?  @map("external_order_id")
  rawData         Json     @map("raw_data")
  normalizedData  Json?    @map("normalized_data")
  errorCode       String?  @map("error_code")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  import       BranchSalesImport    @relation(fields: [importId], references: [id])
  salesHistory ImportedSalesHistory[]

  @@unique([importId, rowNumber])
  @@index([companyId])
  @@index([companyId, branchId])
  @@index([importId])
  @@index([companyId, status])
  @@index([externalOrderId])
  @@map("branch_sales_import_rows")
}

model ImportedSalesHistory {
  id              String    @id @default(cuid()) @map("id")
  companyId       String    @map("company_id")
  branchId        String    @map("branch_id")
  importId        String?   @map("import_id")
  importRowId     String?   @map("import_row_id")
  externalOrderId String?   @map("external_order_id")
  sourceType      String    @default("IMPORTED_HISTORY") @map("source_type")
  saleDate        DateTime  @map("sale_date")
  channel         String?   @map("channel")
  paymentMethod   String?   @map("payment_method")
  operatorId      String?   @map("operator_id")
  waiterId        String?   @map("waiter_id")
  customerId      String?   @map("customer_id")
  productId       String?   @map("product_id")
  productName     String?   @map("product_name")
  categoryId      String?   @map("category_id")
  categoryName    String?   @map("category_name")
  quantity        Decimal?  @map("quantity") @db.Decimal(14, 4)
  grossAmount     Decimal?  @map("gross_amount") @db.Decimal(14, 2)
  discountAmount  Decimal?  @map("discount_amount") @db.Decimal(14, 2)
  netAmount       Decimal?  @map("net_amount") @db.Decimal(14, 2)
  costAmount      Decimal?  @map("cost_amount") @db.Decimal(14, 2)
  cmvPercent      Decimal?  @map("cmv_percent") @db.Decimal(8, 4)
  dataStatus      String    @default("PARTIAL_DATA") @map("data_status")
  metadata        Json?     @map("metadata")
  createdAt       DateTime  @default(now()) @map("created_at")

  import    BranchSalesImport?    @relation(fields: [importId], references: [id])
  importRow BranchSalesImportRow? @relation(fields: [importRowId], references: [id])

  @@unique([companyId, branchId, externalOrderId, productId, saleDate])
  @@index([companyId])
  @@index([companyId, branchId])
  @@index([companyId, branchId, saleDate])
  @@index([companyId, channel])
  @@index([companyId, paymentMethod])
  @@index([companyId, productId])
  @@index([companyId, categoryId])
  @@index([companyId, operatorId])
  @@index([companyId, waiterId])
  @@index([companyId, dataStatus])
  @@map("imported_sales_history")
}

model ReportSnapshot {
  id                String    @id @default(cuid()) @map("id")
  companyId         String    @map("company_id")
  branchId          String?   @map("branch_id")
  reportKey         String    @map("report_key")
  reportType        String    @map("report_type")
  periodStart       DateTime? @map("period_start")
  periodEnd         DateTime? @map("period_end")
  dataStatus        String    @default("NO_DATA") @map("data_status")
  payload           Json      @map("payload")
  metadata          Json?     @map("metadata")
  generatedByUserId String?   @map("generated_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([companyId, reportKey])
  @@index([companyId, reportType])
  @@index([companyId, periodStart, periodEnd])
  @@index([companyId, dataStatus])
  @@index([createdAt])
  @@map("report_snapshots")
}

model MetricSnapshot {
  id           String    @id @default(cuid()) @map("id")
  companyId    String    @map("company_id")
  branchId     String?   @map("branch_id")
  metricKey    String    @map("metric_key")
  metricType   String    @map("metric_type")
  periodStart  DateTime? @map("period_start")
  periodEnd    DateTime? @map("period_end")
  numericValue Decimal?  @map("numeric_value") @db.Decimal(18, 4)
  textValue    String?   @map("text_value")
  dataStatus   String    @default("NO_DATA") @map("data_status")
  dimensions   Json?     @map("dimensions")
  metadata     Json?     @map("metadata")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([companyId, metricKey])
  @@index([companyId, metricType])
  @@index([companyId, periodStart, periodEnd])
  @@index([companyId, dataStatus])
  @@index([createdAt])
  @@map("metric_snapshots")
}
