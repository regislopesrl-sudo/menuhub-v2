model DeliveryZone {
  id                         String    @id @default(cuid()) @map("id")
  companyId                  String    @map("company_id")
  branchId                   String    @map("branch_id")
  name                       String    @map("name")
  type                       String    @map("type")
  status                     String    @default("ACTIVE") @map("status")
  priority                   Int       @default(100) @map("priority")
  deliveryFee                Decimal   @default(0) @db.Decimal(14, 2) @map("delivery_fee")
  minimumOrderAmount         Decimal?  @db.Decimal(14, 2) @map("minimum_order_amount")
  estimatedMinutesMin        Int?      @map("estimated_minutes_min")
  estimatedMinutesMax        Int?      @map("estimated_minutes_max")
  baseLatitude               Decimal?  @db.Decimal(10, 7) @map("base_latitude")
  baseLongitude              Decimal?  @db.Decimal(10, 7) @map("base_longitude")
  radiusKm                   Decimal?  @db.Decimal(10, 3) @map("radius_km")
  feePerKm                   Decimal?  @db.Decimal(14, 4) @map("fee_per_km")
  maxDistanceKm              Decimal?  @db.Decimal(10, 3) @map("max_distance_km")
  courierFee                 Decimal?  @db.Decimal(14, 2) @map("courier_fee")
  courierFeeType             String?   @map("courier_fee_type")
  isBlockedArea              Boolean   @default(false) @map("is_blocked_area")
  blockedReason              String?   @map("blocked_reason")
  requiresManualNegotiation  Boolean   @default(false) @map("requires_manual_negotiation")
  negotiationChannel         String?   @map("negotiation_channel")
  negotiationMessage         String?   @map("negotiation_message")
  visibleOnDeliverySite      Boolean   @default(true) @map("visible_on_delivery_site")
  notes                      String?   @map("notes")
  metadata                   Json?     @map("metadata")
  createdByUserId            String?   @map("created_by_user_id")
  updatedByUserId            String?   @map("updated_by_user_id")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  archivedAt                 DateTime? @map("archived_at")

  neighborhoods              DeliveryZoneNeighborhood[]
  postalCodeRanges           DeliveryZonePostalCodeRange[]
  polygonPoints              DeliveryZonePolygonPoint[]
  schedules                  DeliveryZoneSchedule[]
  dynamicPricingRules        DeliveryZoneDynamicPricingRule[]
  validationLogs             DeliveryAddressValidationLog[]

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([companyId, branchId, status])
  @@index([companyId, branchId, type])
  @@index([companyId, branchId, priority])
  @@unique([companyId, branchId, name])
  @@map("delivery_zones")
}

model DeliveryZoneNeighborhood {
  id                   String   @id @default(cuid()) @map("id")
  companyId            String   @map("company_id")
  branchId             String   @map("branch_id")
  zoneId               String   @map("zone_id")
  neighborhood         String   @map("neighborhood")
  alias                String?  @map("alias")
  normalizedNeighborhood String? @map("normalized_neighborhood")
  normalizedAlias      String?  @map("normalized_alias")
  city                 String?  @map("city")
  state                String?  @map("state")
  deliveryFeeOverride  Decimal? @db.Decimal(14, 2) @map("delivery_fee_override")
  minimumOrderOverride Decimal? @db.Decimal(14, 2) @map("minimum_order_override")
  courierFeeOverride   Decimal? @db.Decimal(14, 2) @map("courier_fee_override")
  estimatedMinutesMin  Int?     @map("estimated_minutes_min")
  estimatedMinutesMax  Int?     @map("estimated_minutes_max")
  visibleOnDeliverySite Boolean @default(true) @map("visible_on_delivery_site")
  status               String   @default("ACTIVE") @map("status")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  zone                 DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([zoneId])
  @@index([companyId, branchId, neighborhood])
  @@index([companyId, branchId, normalizedNeighborhood])
  @@unique([zoneId, neighborhood, city, state])
  @@map("delivery_zone_neighborhoods")
}

model DeliveryZonePostalCodeRange {
  id                   String   @id @default(cuid()) @map("id")
  companyId            String   @map("company_id")
  branchId             String   @map("branch_id")
  zoneId               String   @map("zone_id")
  postalCodeStart      String   @map("postal_code_start")
  postalCodeEnd        String   @map("postal_code_end")
  deliveryFeeOverride  Decimal? @db.Decimal(14, 2) @map("delivery_fee_override")
  minimumOrderOverride Decimal? @db.Decimal(14, 2) @map("minimum_order_override")
  courierFeeOverride   Decimal? @db.Decimal(14, 2) @map("courier_fee_override")
  estimatedMinutesMin  Int?     @map("estimated_minutes_min")
  estimatedMinutesMax  Int?     @map("estimated_minutes_max")
  visibleOnDeliverySite Boolean @default(true) @map("visible_on_delivery_site")
  status               String   @default("ACTIVE") @map("status")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  zone                 DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([zoneId])
  @@index([postalCodeStart])
  @@index([postalCodeEnd])
  @@unique([zoneId, postalCodeStart, postalCodeEnd])
  @@map("delivery_zone_postal_code_ranges")
}

model DeliveryZonePolygonPoint {
  id        String   @id @default(cuid()) @map("id")
  companyId String  @map("company_id")
  branchId  String  @map("branch_id")
  zoneId    String  @map("zone_id")
  sortOrder Int     @map("sort_order")
  latitude  Decimal @db.Decimal(10, 7) @map("latitude")
  longitude Decimal @db.Decimal(10, 7) @map("longitude")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([zoneId])
  @@unique([zoneId, sortOrder])
  @@map("delivery_zone_polygon_points")
}

model DeliveryZoneSchedule {
  id        String   @id @default(cuid()) @map("id")
  companyId String  @map("company_id")
  branchId  String  @map("branch_id")
  zoneId    String  @map("zone_id")
  dayOfWeek Int     @map("day_of_week")
  startTime String  @map("start_time")
  endTime   String  @map("end_time")
  mode      String  @default("ACTIVE_WINDOW") @map("mode")
  status    String  @default("ACTIVE") @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([zoneId])
  @@index([dayOfWeek])
  @@unique([zoneId, dayOfWeek, startTime, endTime, mode])
  @@map("delivery_zone_schedules")
}

model DeliveryZoneDynamicPricingRule {
  id               String   @id @default(cuid()) @map("id")
  companyId        String   @map("company_id")
  branchId         String   @map("branch_id")
  zoneId           String   @map("zone_id")
  name             String   @map("name")
  status           String   @default("ACTIVE") @map("status")
  dayOfWeek        Int?     @map("day_of_week")
  startTime        String?  @map("start_time")
  endTime          String?  @map("end_time")
  adjustmentType   String   @map("adjustment_type")
  adjustmentAmount Decimal  @db.Decimal(14, 2) @map("adjustment_amount")
  priority         Int      @default(100) @map("priority")
  metadata         Json?    @map("metadata")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  zone             DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([zoneId])
  @@index([companyId, branchId, status])
  @@index([dayOfWeek])
  @@map("delivery_zone_dynamic_pricing_rules")
}

model DeliveryAddressValidationLog {
  id                         String   @id @default(cuid()) @map("id")
  companyId                  String   @map("company_id")
  branchId                   String   @map("branch_id")
  zoneId                     String?  @map("zone_id")
  status                     String   @map("status")
  reason                     String?  @map("reason")
  postalCode                 String?  @map("postal_code")
  neighborhood               String?  @map("neighborhood")
  city                       String?  @map("city")
  state                      String?  @map("state")
  latitude                   Decimal? @db.Decimal(10, 7) @map("latitude")
  longitude                  Decimal? @db.Decimal(10, 7) @map("longitude")
  distanceKm                 Decimal? @db.Decimal(10, 3) @map("distance_km")
  deliveryFee                Decimal? @db.Decimal(14, 2) @map("delivery_fee")
  courierFee                 Decimal? @db.Decimal(14, 2) @map("courier_fee")
  minimumOrderAmount         Decimal? @db.Decimal(14, 2) @map("minimum_order_amount")
  estimatedMinutesMin        Int?     @map("estimated_minutes_min")
  estimatedMinutesMax        Int?     @map("estimated_minutes_max")
  requiresManualNegotiation  Boolean  @default(false) @map("requires_manual_negotiation")
  dynamicPricingApplied      Boolean  @default(false) @map("dynamic_pricing_applied")
  source                     String   @default("CHECKOUT") @map("source")
  metadata                   Json?    @map("metadata")
  createdAt                  DateTime @default(now()) @map("created_at")

  zone                       DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([companyId, branchId, status])
  @@index([zoneId])
  @@index([postalCode])
  @@index([createdAt])
  @@map("delivery_address_validation_logs")
}
